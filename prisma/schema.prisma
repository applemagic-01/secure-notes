generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A share is either consumed once or remains usable until its deadline.
enum ShareType {
  ONE_TIME
  TIME_BASED
}

// Public links need only the secret URL; password links also require an access key.
enum AccessType {
  PUBLIC
  PASSWORD
}

// A user owns notes and authenticated sessions.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes        Note[]
  sessions     Session[]
}

// Sessions store only a hash of the browser token.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Notes are private by default and are exposed through controlled share links.
model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks ShareLink[]

  @@index([userId])
}

// ShareLink stores the rules that decide whether a shared URL can be used.
model ShareLink {
  id           String     @id @default(cuid())
  noteId       String
  tokenHash    String     @unique
  shareType    ShareType
  accessType   AccessType
  passwordHash String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  usedAt       DateTime?
  viewCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  note       Note        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  viewEvents ViewEvent[]

  @@index([noteId])
  @@index([expiresAt])
}

// Each successful access creates an audit/event record.
model ViewEvent {
  id          String   @id @default(cuid())
  shareLinkId String
  createdAt   DateTime @default(now())

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
}